generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pets      Pet[]
  adoptions Adoption[]
}

model Pet {
  id              String    @id @default(cuid())
  name            String?
  nameNormalized  String?
  species         Species
  breed           String?
  breedNormalized String?
  age             Int?
  description     String?
  imageUrls       Json      @default("[]")
  gender          Gender?
  status          PetStatus @default(AVAILABLE)
  situation       Situation @default(SHELTER)
  waitingSince    DateTime  @default(now())
  latitude        Float?
  longitude       Float?
  locationNote    String?
  locationPhone   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  adoptions   Adoption[]

  @@index([createdById])
  @@index([species, status])
  @@index([nameNormalized])
  @@index([breedNormalized])
}

model SearchHistory {
  id        String   @id @default(cuid())
  query     String   @unique
  count     Int      @default(1)
  lastUsed  DateTime @default(now())
}

model Adoption {
  id        String         @id @default(cuid())
  status    AdoptionStatus @default(PENDING)
  message   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  petId  String
  pet    Pet    @relation(fields: [petId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([petId])
  @@index([userId])
}

enum Gender {
  MALE
  FEMALE
}

enum Situation {
  SHELTER
  ABANDONED
  FOSTER
  STREET
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum PetStatus {
  AVAILABLE
  UNDER_REVIEW
  ADOPTED
}

enum AdoptionStatus {
  PENDING
  APPROVED
  REJECTED
}
