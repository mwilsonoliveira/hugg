TURSO_DATABASE_URL=file:../../packages/database/prisma/dev.db
TURSO_AUTH_TOKEN=
JWT_SECRET=change-me-in-production
BLOB_READ_WRITE_TOKEN=
MAINTENANCE_MODE=false

# Mapa do seletor de localização (a chave é pública no bundle do navegador).
# No Google Cloud, habilite Maps JavaScript API e faturamento e restrinja a chave
# à API e às origens HTTP usadas, por exemplo http://localhost:3000/*.
# Reinicie o servidor Next após alterar esta variável.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# O seed local usa estes defaults quando omitidos:
# SEED_ADMIN_EMAIL=admin@hugg.com
# SEED_ADMIN_PASSWORD=hugg123456
# Nunca habilite ALLOW_REMOTE_SEED com a senha local padrão.
